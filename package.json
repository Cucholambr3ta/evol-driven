{
  "name": "evol-driven",
  "version": "0.3.1",
  "description": "Framework de desarrollo que evoluciona: proyectos TypeScript con pipeline de disciplinas Driven Development y memoria persistente (MemPalace).",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "evol": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "disciplines",
    "rules",
    "skills",
    "!skills/*/evals",
    "README.md",
    "DEPENDENCIES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "ci": "npm run lint && npm run typecheck && npm run format && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
